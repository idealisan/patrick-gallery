# 原版 Immich 并排对比用环境变量（复制为 .env 后按需修改）
# docker-compose.yml 通过 env_file 读取本文件。

DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# 首次启动引导创建的管理员；与 immich-go 默认管理员一致，便于并排对比。
# 若服务器未开放 env 引导，请改在 http://localhost:2283 网页完成初始化。
IMMICH_ADMIN_EMAIL=admin@immich.app
IMMICH_ADMIN_PASSWORD=password
